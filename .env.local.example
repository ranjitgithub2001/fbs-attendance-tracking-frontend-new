# COPY to .env.local (gitignored). Vite loads this over .env.
# Local-copy backend (Spring profile local) on 8082:
#   npm run dev -- --port 5174
VITE_API_URL=http://localhost:8082/api
#
# Hosted read-only backend (Spring profile hosted-readonly) uses port 8084.
# Copy .env.hosted-readonly.example to .env.local for that mode.
#
# DigitalOcean production builds ignore this file. Set BUILD_TIME VITE_API_URL
# (see .do/app.yaml and .env.production.example) to the public API origin + /api.
